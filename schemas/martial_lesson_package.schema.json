{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MartialArtsLessonPackage/v1",
  "title": "Martial Arts Lesson Package approved manifest",
  "type": "object",
  "required": ["schema", "project_id", "lesson_id", "chapter", "art_id", "art_version", "move_id", "facts", "teacher", "motion_source", "video", "shots", "assets", "production_rules", "audiovisual_review", "placeholders"],
  "properties": {
    "schema": {"const": "MartialArtsLessonPackage/v1"},
    "project_id": {"const": "wuxiang"},
    "lesson_id": {"type": "string"},
    "chapter": {"type": "string"},
    "art_id": {"type": "string"},
    "art_version": {"type": "integer", "minimum": 1},
    "move_id": {"type": "string"},
    "facts": {"type": "object", "required": ["move_version", "sha256"]},
    "teacher": {"type": "object", "required": ["master_id", "master_version", "visual_asset_id", "visual_sha256", "voice_id"]},
    "motion_source": {"type": "object", "required": ["reference_id", "version", "asset_id", "sha256"]},
    "video": {"type": "object", "required": ["final_id", "asset_id", "media_job_id", "provider", "model", "prompt_hash", "sha256", "martial_qc_id", "martial_qc_sha256"]},
    "shots": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["shot_id", "version", "ordinal", "purpose", "start_state", "end_state", "camera", "duration"]}},
    "assets": {"type": "array", "items": {"type": "object", "required": ["role", "shot_id", "version", "registry_asset_id", "registry_version", "sha256", "file_ref"]}},
    "production_rules": {"type": "array", "items": {"type": "object", "required": ["id", "version", "learning_review", "reviewer", "rule", "conditions", "counterexamples", "evidence_sha256", "scope", "status"]}},
    "audiovisual_review": {"type": "object", "required": ["version", "reviewer_id", "sha256"]},
    "placeholders": {"type": "array", "items": {"enum": ["narrative_voice", "bgm", "sfx", "subtitle"]}}
  },
  "additionalProperties": false
}
